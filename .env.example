# --- Zendesk connection (required) ---
# yourcompany -> yourcompany.zendesk.com (or set ZENDESK_DOMAIN for a host-mapped domain)
ZENDESK_SUBDOMAIN=yourcompany
# ZENDESK_DOMAIN=support.yourcompany.com
ZENDESK_EMAIL=you@yourcompany.com
# Option A — API token: Admin Center > Apps and integrations > APIs > Zendesk API > Add API token
ZENDESK_API_TOKEN=
# Option B — OAuth client (Admin Center > Apps and integrations > APIs > OAuth clients; kind: Confidential).
# Use the client's "Identifier" and "Secret"; the server fetches and renews access tokens itself.
# ZENDESK_CLIENT_ID=
# ZENDESK_CLIENT_SECRET=
# ZENDESK_OAUTH_SCOPE=read write
# Option C — an existing OAuth *access token* (not a client secret):
# ZENDESK_OAUTH_TOKEN=

# --- Safety ---
# full | no_delete | read_only
ZENDESK_ACCESS_MODE=full
# Directory that local file uploads/downloads are confined to (unset = local file access disabled)
# ZENDESK_FILE_ROOT=~/zendesk-files
# Where report targets (goals for green/amber/red) are stored; default ZENDESK_FILE_ROOT or ~/.zendesk-mcp
# ZENDESK_TARGETS_FILE=~/zendesk-files/zendesk_targets.json
# Change journal (every write, with before-state, enables revert_change). Default: on, in ZENDESK_FILE_ROOT
# ZENDESK_JOURNAL=on
# ZENDESK_JOURNAL_FILE=~/zendesk-files/zendesk_changes.jsonl
# Which tools to load: all (default), or a comma list of core, analytics, admin
# ZENDESK_TOOLSETS=all

# --- HTTP transport (only for --transport http / Docker) ---
# Required when listening on anything other than localhost. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Optional Host-header allowlist, e.g. zendesk-mcp.home.lan,192.168.1.20:8000
# MCP_ALLOWED_HOSTS=

# --- Tuning ---
# Results larger than this many characters are trimmed (whole items dropped, JSON stays valid)
# ZENDESK_MAX_RESPONSE_CHARS=60000
# ZENDESK_DEFAULT_LIMIT=100
# ZENDESK_TIMEOUT=30
# ZENDESK_MAX_RETRIES=4
# LOG_LEVEL=INFO
